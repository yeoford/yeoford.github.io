---
import { ClientRouter } from 'astro:transitions';

import BaseHead from '@components/layout/base-head.astro';
import Header from '@components/layout/header.astro';
import Tracker from '@components/layout/tracker.astro';
import Countryside from '@images/countryside.jpg';

interface Props {
  description: string;
  image?: string;
  title: string;
}

const { description, image = Countryside.src, title } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead description={description} image={image} title={title} />
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-emerald-500">
    <div
      class="relative aspect-[3/1] max-h-[200px] w-full sm:aspect-[4/1] md:aspect-[5/2] lg:aspect-[16/5]"
      transition:name="header-image"
    >
      <img
        alt=""
        class="h-full max-h-[200px] w-full object-cover object-center"
        decoding="async"
        loading="eager"
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 100vw, 100vw"
        src={Countryside.src}
        transition:name="header-image-content"
      />
      <div
        class="absolute inset-0 flex flex-col items-center justify-center bg-black/60"
      >
        <a
          class="font-['Roboto_Slab'] text-4xl font-bold text-white no-underline md:text-4xl"
          href="/"
          transition:name="site-title">Yeoford Village</a
        >
        <div class="hidden w-full md:block">
          <Header />
        </div>
      </div>
    </div>
    <div class="md:hidden">
      <Header />
    </div>
    <main class="flex-grow">
      <div
        class="container mx-auto mt-10 rounded-lg bg-white/80 px-4 py-8 pb-16 md:px-16"
        transition:name="main-content"
      >
        <slot />
      </div>
    </main>
    <Tracker />
  </body>
</html>
