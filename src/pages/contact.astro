---
import Layout from '@layouts/page.astro';
---

<Layout>
  <h1 class="mb-6 text-3xl font-bold">Contact</h1>

  <div class="mb-4">
    If you would like to find out more about the groups and events in the
    village, or would like to book a facility contact us using the form. Please
    fill in all of the sections:
  </div>

  <form class="max-w-lg" id="contactForm">
    <div class="mb-4">
      <label class="mb-2 block text-lg font-medium" for="name"
        >Your Name (required)</label
      >
      <input
        class="w-full rounded-md border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none"
        id="name"
        name="name"
        required
        type="text"
      />
    </div>

    <div class="mb-4">
      <label class="mb-2 block text-lg font-medium" for="email"
        >Your Email (required)</label
      >
      <input
        class="w-full rounded-md border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none"
        id="email"
        name="email"
        required
        type="email"
      />
    </div>

    <div class="mb-4">
      <label class="mb-2 block text-lg font-medium" for="subject"
        >Subject (required)</label
      >
      <input
        class="w-full rounded-md border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none"
        id="subject"
        name="subject"
        required
        type="text"
      />
    </div>

    <div class="mb-4">
      <label class="mb-2 block text-lg font-medium" for="message"
        >Message (required)</label
      >
      <textarea
        class="w-full rounded-md border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none"
        id="message"
        name="message"
        required
        rows="4"></textarea>
    </div>

    <button
      class="rounded-md bg-blue-500 px-4 py-2 text-white hover:bg-blue-600 focus:ring-2 focus:ring-blue-500 focus:outline-none"
      type="submit"
    >
      Send
    </button>
  </form>
</Layout>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;

  if (form) {
    form.addEventListener('submit', e => {
      e.preventDefault();

      const nameInput = document.getElementById('name') as HTMLInputElement;
      const emailInput = document.getElementById('email') as HTMLInputElement;
      const subjectInput = document.getElementById(
        'subject'
      ) as HTMLInputElement;
      const messageInput = document.getElementById(
        'message'
      ) as HTMLTextAreaElement;

      if (nameInput && emailInput && subjectInput && messageInput) {
        const name = nameInput.value;
        const email = emailInput.value;
        const subject = subjectInput.value;
        const message = messageInput.value;

        const mailtoBody = `Hello,

My name is ${name}.
My email is ${email}.

Message:

${message}

---
This email was pre-filled from the yeoford.org contact form.`;

        const encodedBody = encodeURIComponent(mailtoBody);

        const mailtoLink = `mailto:admin.hall@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodedBody}`;

        window.location.href = mailtoLink;
      }
    });
  }
</script>
