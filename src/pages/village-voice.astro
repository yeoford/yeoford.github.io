---
import { PdfViewer } from '@components/pdf-viewer';
import { getLatestIssue, getPublishedNewsletters } from '@helpers/astro';
import { formatPublicationMonth } from '@helpers/newsletter/model';
import Layout from '@layouts/page.astro';

const newsletter = getLatestIssue(await getPublishedNewsletters());
---

<Layout>
  <div class="container mx-auto px-4 py-8">
    <h1 class="mb-6 text-3xl font-bold">
      Village Voice {newsletter.data.issueNumber} -
      {formatPublicationMonth(newsletter.data.publicationMonth)}
    </h1>
    <div class="flex flex-col gap-4">
      <PdfViewer client:only="react" path={newsletter.data.pdfPath} />
      <div class="mt-4 text-center">
        <a
          class="inline-flex items-center rounded-md bg-green-600 px-4 py-2 text-white transition-colors hover:bg-green-700"
          download
          href={newsletter.data.pdfPath}
        >
          <svg
            class="mr-2 h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"></path>
          </svg>
          Download PDF
        </a>
      </div>
    </div>
  </div>
</Layout>
