---
import Card from '@components/vv-card.astro';
import {
  getPublishedNewsletters,
  sortEntriesByNewestPublicationMonth
} from '@helpers/astro';
import { formatPublicationMonth } from '@helpers/newsletter/model';
import Layout from '@layouts/page.astro';

const newsletters = await getPublishedNewsletters();
const sortedNewsletters = sortEntriesByNewestPublicationMonth(newsletters);
---

<Layout>
  <h1 class="mb-6 text-3xl font-bold">Village Voice</h1>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
    {
      sortedNewsletters.map(newsletter => (
        <Card
          description={newsletter.data.description}
          image={newsletter.data.coverPath}
          link={`/newsletter/${newsletter.data.id}`}
          title={`Village Voice - ${formatPublicationMonth(newsletter.data.publicationMonth)}`}
        />
      ))
    }
  </div>
</Layout>
