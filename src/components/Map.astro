---
import 'maplibre-gl/dist/maplibre-gl.css';

interface Props {
  center?: [number, number];
  height?: string;
  zoom?: number;
}

const {
  center = [-3.725, 50.776], // Default to Yeoford coordinates
  height = '500px',
  zoom = 14
} = Astro.props;
---

<div
  aria-label="Map of Yeoford"
  class="map-container"
  data-center={JSON.stringify(center)}
  data-map
  data-style="https://tiles.openfreemap.org/styles/liberty"
  data-zoom={zoom}
  style={`width: 100%; height: ${height};`}
  transition:name="map"
>
  <div class="map-fallback" role="status">
    <p>Loading map...</p>
    <a
      href="https://www.openstreetmap.org/search?query=Yeoford%2C%20Devon"
      rel="noopener noreferrer"
      target="_blank">Open Yeoford on OpenStreetMap</a
    >
  </div>
</div>

<script>
  import { Map as MapLibreMap } from 'maplibre-gl';

  const maps = new Map<HTMLElement, MapLibreMap>();

  const showMapFallback = (container: HTMLElement, message: string) => {
    const fallback = container.querySelector<HTMLElement>('.map-fallback');
    if (!fallback) {
      return;
    }

    fallback.hidden = false;
    const text = fallback.querySelector('p');
    if (text) {
      text.textContent = message;
    }
  };

  const hideMapFallback = (container: HTMLElement) => {
    const fallback = container.querySelector<HTMLElement>('.map-fallback');
    if (fallback) {
      fallback.hidden = true;
    }
  };

  const initializeMaps = () => {
    for (const container of document.querySelectorAll<HTMLElement>(
      '[data-map]'
    )) {
      if (maps.has(container)) {
        continue;
      }

      const center = JSON.parse(container.dataset.center ?? '[]') as [
        number,
        number
      ];
      const map = new MapLibreMap({
        center,
        container,
        style: container.dataset.style,
        zoom: Number(container.dataset.zoom)
      });
      maps.set(container, map);

      let loaded = false;
      map.once('load', () => {
        loaded = true;
        hideMapFallback(container);
      });
      map.once('error', () => {
        if (!loaded) {
          showMapFallback(container, 'Map unavailable');
        }
      });
    }
  };

  const destroyMaps = () => {
    for (const map of maps.values()) {
      map.remove();
    }
    maps.clear();
  };

  initializeMaps();
  document.addEventListener('astro:page-load', initializeMaps);
  document.addEventListener('astro:before-swap', destroyMaps);
</script>

<style>
  .map-container {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: #eef2f6;
  }

  .map-fallback {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    text-align: center;
    color: #334155;
  }

  .map-fallback[hidden] {
    display: none;
  }

  .map-fallback p {
    margin: 0;
    font-size: 1rem;
  }

  .map-fallback a {
    color: #2563eb;
    text-decoration: underline;
  }
</style>
