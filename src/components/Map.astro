---
interface Props {
  center?: [number, number];
  height?: string;
  zoom?: number;
}

const {
  center = [-3.725, 50.776], // Default to Yeoford coordinates
  height = '500px',
  zoom = 14
} = Astro.props;

const maplibreBaseUrl = 'https://unpkg.com/maplibre-gl@5.6.2/dist';
const mapStyleUrl = 'https://tiles.openfreemap.org/styles/liberty';
---

<div
  aria-label="Map of Yeoford"
  class="map-container"
  id="map"
  style={`width: 100%; height: ${height};`}
  transition:name="map">
  <div class="map-fallback" id="map-fallback" role="status">
    <p>Loading map...</p>
    <a
      href="https://www.openstreetmap.org/search?query=Yeoford%2C%20Devon"
      rel="noopener noreferrer"
      target="_blank">Open Yeoford on OpenStreetMap</a
    >
  </div>
</div>

<script define:vars={{ center, maplibreBaseUrl, mapStyleUrl, zoom }} is:inline>
  let map = null;
  const pendingAssets = new Map();

  function loadScript(src) {
    if (window.maplibregl) {
      return Promise.resolve();
    }
    if (pendingAssets.has(src)) {
      return pendingAssets.get(src);
    }

    const pendingScript = new Promise((resolve, reject) => {
      if (document.querySelector(`script[src='${src}']`)) {
        resolve();
        return;
      }
      const script = document.createElement('script');
      script.src = src;
      script.onload = resolve;
      script.onerror = reject;
      document.head.append(script);
    }).finally(() => pendingAssets.delete(src));
    pendingAssets.set(src, pendingScript);
    return pendingScript;
  }

  function loadCSS(href) {
    if (pendingAssets.has(href)) {
      return pendingAssets.get(href);
    }

    const pendingStylesheet = new Promise((resolve, reject) => {
      if (document.querySelector(`link[href='${href}']`)) {
        resolve();
        return;
      }
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      link.onload = resolve;
      link.onerror = reject;
      document.head.append(link);
    }).finally(() => pendingAssets.delete(href));
    pendingAssets.set(href, pendingStylesheet);
    return pendingStylesheet;
  }

  function showMapFallback(message) {
    const fallback = document.getElementById('map-fallback');
    if (!fallback) {
      return;
    }
    fallback.hidden = false;
    const text = fallback.querySelector('p');
    if (text) {
      text.textContent = message;
    }
  }

  function hideMapFallback() {
    const fallback = document.getElementById('map-fallback');
    if (fallback) {
      fallback.hidden = true;
    }
  }

  async function initMapWithLib() {
    try {
      await loadCSS(`${maplibreBaseUrl}/maplibre-gl.css`);
      await loadScript(`${maplibreBaseUrl}/maplibre-gl.js`);
      initMap();
    } catch (error) {
      console.error('Unable to load map library', error);
      showMapFallback('Map unavailable');
    }
  }

  function initMap() {
    const container = document.getElementById('map');
    if (!container) {
      setTimeout(initMap, 50);
      return;
    }
    if (map) {
      map.remove();
    }
    map = new window.maplibregl.Map({
      center,
      container: 'map',
      style: mapStyleUrl,
      zoom
    });
    let loaded = false;
    map.once('load', () => {
      loaded = true;
      hideMapFallback();
    });
    map.once('error', () => {
      if (!loaded) {
        showMapFallback('Map unavailable');
      }
    });
  }

  initMapWithLib();
  document.addEventListener('astro:after-swap', initMapWithLib);
</script>

<style>
  .map-container {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: #eef2f6;
  }

  .map-fallback {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    text-align: center;
    color: #334155;
  }

  .map-fallback[hidden] {
    display: none;
  }

  .map-fallback p {
    margin: 0;
    font-size: 1rem;
  }

  .map-fallback a {
    color: #2563eb;
    text-decoration: underline;
  }
</style>
