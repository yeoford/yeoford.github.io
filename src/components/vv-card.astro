---
interface Props {
  description: string;
  image: string;
  link: string;
  title: string;
}
const { description, image, link, title } = Astro.props;
---

<article
  class="flex h-full flex-col overflow-hidden rounded-lg bg-emerald-100 shadow-lg"
>
  <a class="block transition-opacity duration-200 hover:opacity-90" href={link}>
    <div class="flex flex-1 flex-col p-4">
      <h2 class="mb-2 text-xl font-semibold">{title}</h2>
    </div>
    <img
      alt={title}
      class="image-zoom h-48 w-full object-cover"
      loading="lazy"
      src={image}
    />
    <div class="flex flex-1 flex-col p-4">
      <p class="mb-4 flex-1 !text-sm text-gray-500">{description}</p>
      <span class="arrow-link font-medium text-blue-600">Read more →</span>
    </div>
  </a>
</article>

<style>
  article {
    transition: box-shadow 0.2s;
  }
  article:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }
  .arrow-link {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  article:hover .arrow-link {
    transform: translateX(4px);
  }
  .image-zoom {
    transition: transform 0.3s ease;
  }
  article:hover .image-zoom {
    transform: scale(1.05);
  }
</style>
