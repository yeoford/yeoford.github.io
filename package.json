{
  "name": "org-yeoford",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "knip": {
    "ignoreBinaries": [
      "gs"
    ]
  },
  "overrides": {
    "ajv": "6.14.0",
    "flatted": "3.4.3",
    "mdast-util-to-hast": "13.2.1",
    "picomatch": "4.0.5",
    "postcss": "8.5.24",
    "rollup": "4.59.0",
    "sharp": "0.35.3",
    "vite": "8.2.2"
  },
  "scripts": {
    "astro": "astro",
    "build": "bunx --bun astro build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test --run && bun run unused && bun audit --audit-level=high && bun run newsletter:check && bun run build && bun run test:e2e:run",
    "prebuild": "bun run newsletter:generate",
    "predev": "bun run newsletter:generate",
    "dev": "bunx --bun astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/.eslintcache .",
    "lint:fix": "eslint --fix .",
    "newsletter:add": "bun scripts/newsletter.ts add",
    "newsletter:check": "bun scripts/newsletter.ts check",
    "newsletter:generate": "bun scripts/newsletter.ts generate",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "preview": "bunx --bun astro preview",
    "typecheck": "astro check",
    "unused": "knip",
    "test": "vitest",
    "test:e2e": "bun run build && bun run test:e2e:run",
    "test:e2e:run": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@hyzyla/pdfium": "2.1.13",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.4",
    "maplibre-gl": "6.5.0",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "10.5.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "10.9.0",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.32.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
