{
  "name": "org-yeoford",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "overrides": {
    "vite": "6.4.3"
  },
  "scripts": {
    "astro": "astro",
    "build": "bunx --bun astro build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test --run && bun run unused && bun run build && bun run test:e2e:run",
    "prebuild": "bun run process-newsletters",
    "dev": "bunx --bun astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/.eslintcache .",
    "lint:fix": "eslint --fix .",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "preview": "bunx --bun astro preview",
    "process-newsletters": "bun scripts/process-newletters.ts",
    "typecheck": "astro check",
    "unused": "knip",
    "test": "vitest",
    "test:e2e": "bun run build && bun run test:e2e:run",
    "test:e2e:run": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.3",
    "@napi-rs/canvas": "^0.1.100",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "github-slugger": "^2.0.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^9.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nkzw/eslint-config": "3.2.1",
    "@playwright/test": "1.62.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^3.0.1",
    "knip": "^5.88.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vitest": "^3.2.7"
  }
}
