{
  "name": "org-yeoford",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "astro": "astro",
    "build": "bunx --bun astro build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test --run && bun run unused && bun run build && bun run test:e2e:run",
    "prebuild": "bun run process-newsletters",
    "dev": "bunx --bun astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/.eslintcache .",
    "lint:fix": "eslint --fix .",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "preview": "bunx --bun astro preview",
    "process-newsletters": "bun scripts/process-newletters.ts",
    "typecheck": "astro check",
    "unused": "knip",
    "test": "vitest",
    "test:e2e": "bun run build && bun run test:e2e:run",
    "test:e2e:run": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@hyzyla/pdfium": "2.1.13",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.1.4",
    "github-slugger": "^2.0.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^9.2.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "1.62.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.29.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
